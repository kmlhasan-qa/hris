{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2020", "dom"]
  },
  "include": [
    "src/**/*.ts",
    "helpers/**/*.ts",
    "tests/**/*.ts",
    "global-setup*.ts",
    "playwright.config.ts"
  ]
}